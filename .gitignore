!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets and belongs in the repo.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase bootstrap files that carry PRIVATE rows.
#
# 02-seed.sql and 03-seed-content.sql contain every entry, including the ones
# marked visibility='private': interview companies, unverified claims and
# private_note text. REVIEW.md names them too. The whole point of the
# visibility model is that this data never reaches a public repo, and these
# files are the one place it exists in plain text.
#
# They are one-time bootstrap files. Keep them locally, run them in the
# Supabase SQL editor, and let the database be their home after that.
supabase/02-seed.sql
supabase/03-seed-content.sql
supabase/04-corrections.sql
supabase/REVIEW.md

# JetBrains project files
.idea/
supabase/05-links.sql

# Browser-automation artifacts
.playwright-mcp/
