# Living Trail data source.
#
# Both values are PUBLIC by design. The anon key can only read the public_*
# views, which are filtered to visibility = 'public' and never expose a
# private column. See supabase/SETUP.md.
#
# Copy this file to .env.local and fill in your own project's values.
# .env.local is gitignored, and Claude is denied read access to it in
# .claude/settings.json.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# The service_role key is NOT used by this project and must never be added
# here. Schema and seed run in the Supabase SQL editor instead.
